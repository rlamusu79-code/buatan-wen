Tahap 2 - Membuat Database

Login ke MariaDB:

sudo mysql

Kalau berhasil akan muncul:

MariaDB [(none)]>
Buat database

Jalankan:

CREATE DATABASE cafepos;

Lalu gunakan database tersebut:

USE cafepos;
Buat tabel users
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    fullname VARCHAR(100) NOT NULL,
    username VARCHAR(50) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    role ENUM('admin','kasir') DEFAULT 'kasir',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
Buat tabel categories
CREATE TABLE categories (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL
);
Buat tabel menus
CREATE TABLE menus (
    id INT AUTO_INCREMENT PRIMARY KEY,
    category_id INT,
    name VARCHAR(100),
    price DECIMAL(10,2),
    stock INT DEFAULT 0,
    image VARCHAR(255),
    FOREIGN KEY (category_id) REFERENCES categories(id)
);
Buat tabel transactions
CREATE TABLE transactions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    invoice VARCHAR(30),
    user_id INT,
    total DECIMAL(12,2),
    payment DECIMAL(12,2),
    change_money DECIMAL(12,2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(user_id) REFERENCES users(id)
);
Buat tabel transaction_details
CREATE TABLE transaction_details (
    id INT AUTO_INCREMENT PRIMARY KEY,
    transaction_id INT,
    menu_id INT,
    qty INT,
    price DECIMAL(10,2),
    subtotal DECIMAL(12,2),
    FOREIGN KEY(transaction_id) REFERENCES transactions(id),
    FOREIGN KEY(menu_id) REFERENCES menus(id)
);
Tambahkan kategori
INSERT INTO categories(name)
VALUES
('Coffee'),
('Non Coffee'),
('Tea'),
('Snack');
Tambahkan contoh menu
INSERT INTO menus(category_id,name,price,stock,image)
VALUES
